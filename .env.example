# LLM Provider: "gemini" or "zai" (auto-detects "zai" if ZAI_API_KEY is set)
AI_PROVIDER=zai

# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Z.ai API Key (Get from https://z.ai/manage-apikey/apikey-list)
# If using a GLM Coding Plan key, keep the coding endpoint below; otherwise
# switch ZAI_BASE_URL to https://api.z.ai/api/paas/v4
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-5.3
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4


# Audio Input Device Name or Index (e.g. Bluetooth HFP Hands-Free or Line-In)
# Run main.py --list-audio to list available device names/indices
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default

# ADB Settings (Switchable: USB or WIRELESS)
ADB_PATH=adb
ADB_MODE=USB
ADB_DEVICE_SERIAL=

# Wireless ADB Settings (Used if ADB_MODE=WIRELESS)
ADB_WIRELESS_IP=192.168.1.50
ADB_WIRELESS_PORT=5555

# System Prompt / Persona for the AI Calling Agent
AI_PERSONA="You are an intelligent, polite, and helpful AI voice assistant handling a phone call. Keep responses concise (1-2 sentences max), natural, and clear."
